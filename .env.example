# PostgreSQL connection string used by the auth system (see src/lib/db.ts)
DATABASE_URL=postgresql://user:password@host:port/agentic-workflow

# JWT signing key (HS256) for access & refresh tokens (see src/lib/jwt.ts)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=replace-with-64-char-random-hex
